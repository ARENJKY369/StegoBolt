<?xml version="1.0" encoding="UTF-8"?>
<!--
  StegoBolt Engine v2.0 — 100% Java in-memory steganography backend.

  Strict architecture directives enforced by this build:
    * Java 17+ / Spring Boot 3.x only — no Node.js, no Python, no serverless routes.
    * Zero-disk processing: multipart uploads are kept in RAM (see
      spring.servlet.multipart.file-size-threshold in application.properties),
      all engine I/O goes through java.io.ByteArray{Input,Output}Stream.
    * Volatile RAM purging: every sensitive byte[] is overwritten with
      Arrays.fill(buf, (byte) 0) inside finally blocks (see MemoryHygiene).
    * Zero payload logging: loggers only ever report status and byte counts.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.stegobolt</groupId>
  <artifactId>stegobolt-engine</artifactId>
  <version>2.0.0</version>
  <name>StegoBolt Engine</name>
  <description>Zero-knowledge, zero-disk, in-RAM steganography engine (Java 17 / Spring Boot 3.x)</description>

  <properties>
    <java.version>17</java.version>
    <commons-imaging.version>1.0-alpha3</commons-imaging.version>
  </properties>

  <dependencies>
    <!-- REST controller layer: multipart/form-data across /hide /extract /scan /clean /capacity -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- EXIF metadata parsing (org.apache.commons.imaging) for /scan and /clean -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-imaging</artifactId>
      <version>${commons-imaging.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
